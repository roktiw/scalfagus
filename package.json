{
  "name": "scalfagus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs --all",
    "doctor:repo": "node scripts/doctor.mjs --repo",
    "verify:seed": "node scripts/verify-seed.mjs",
    "test:seed": "node --test scripts/tests/seed.test.mjs",
    "check:seed": "node scripts/doctor.mjs --repo && node scripts/verify-seed.mjs && node --test scripts/tests/seed.test.mjs",
    "dev:game": "node scripts/dev-game.mjs"
  }
}
