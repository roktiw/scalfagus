extends RefCounted
class_name MirrorReplayArchive

# Deterministic local one-human replay of command ATTEMPTS. A rejected order
# must be replayed too: rejected_commands contributes to the final state hash.
# Bot orders are regenerated by the pinned seed + deterministic bot policy.
# Archives are JSON primitives, never arbitrary Variant Objects or Godot scenes.
const MATCH = preload("res://scripts/mirror_match_state.gd")
const FORMAT_VERSION: int = 1
const MAX_COMMANDS: int = 65536
const MAX_SEED: int = 2147483647

static func capture(sim: MirrorMatchState) -> Dictionary:
    var recorded: Array[Dictionary] = []
    for entry in sim.human_command_history:
        recorded.append(entry.duplicate(true))
    return {
        "format_version": FORMAT_VERSION,
        "archive_type": "scalfagus-human-mirror",
        "rules": str(sim.result()["rules"]),
        "seed": sim.seed,
        "controllers": sim.controllers.duplicate(),
        "map_id": sim.map_id,
        "map_hash": sim.map_hash,
        "map_source_sha": sim.map_source_sha,
        "final_tick": sim.tick,
        "final_hash": sim.replay_hash(),
        "commands": recorded
    }

static func _integer(v: Variant, low: int, high: int) -> bool:
    # Godot JSON may materialize integer literals as floats. Accept only
    # exact integral numbers; keep all wire-side values in signed int32.
    if not (v is int or v is float):
        return false
    if v < low or v > high:
        return false
    return float(v) == floor(float(v))

static func _argument(payload: Variant) -> Dictionary:
    if not (payload is Dictionary):
        return {"ok": false}
    if payload.size() != 2 or not payload.has("type") or not payload.has("value"):
        return {"ok": false}
    var kind: Variant = payload["type"]
    var v: Variant = payload["value"]
    if not (kind is String):
        return {"ok": false}
    match kind:
        "nil":
            if v == null:
                return {"ok": true, "value": null}
        "cell":
            if v is Array and v.size() == 2:
                if _integer(v[0], -2147483648, 2147483647) and _integer(v[1], -2147483648, 2147483647):
                    return {"ok": true, "value": Vector2i(int(v[0]), int(v[1]))}
        "int":
            if _integer(v, -2147483648, 2147483647):
                return {"ok": true, "value": int(v)}
        "float":
            if v is float or v is int:
                if v >= -2147483648.0 and v <= 2147483647.0:
                    return {"ok": true, "value": float(v)}
        "string":
            if v is String and v.length() <= 128:
                return {"ok": true, "value": v}
        "bool":
            if v is bool:
                return {"ok": true, "value": v}
    return {"ok": false}

static func _failure(reason: String, index: int = -1) -> Dictionary:
    return {"ok": false, "reason": reason, "command_index": index}

static func prepare(archive: Variant) -> Dictionary:
    if not (archive is Dictionary):
        return _failure("invalid_document")
    var required: Array[String] = [
        "format_version", "archive_type", "rules", "seed", "controllers",
        "map_id", "map_hash", "map_source_sha", "final_tick",
        "final_hash", "commands"
    ]
    if archive.size() != required.size():
        return _failure("invalid_document")
    for key in required:
        if not archive.has(key):
            return _failure("missing_field_" + key)
    if not _integer(archive["format_version"], FORMAT_VERSION, FORMAT_VERSION):
        return _failure("unsupported_format")
    if archive["archive_type"] != "scalfagus-human-mirror":
        return _failure("unsupported_archive")
    if not _integer(archive["seed"], 0, MAX_SEED):
        return _failure("invalid_seed")
    if not _integer(archive["final_tick"], 0, MATCH.MAX_TICKS):
        return _failure("invalid_final_tick")
    if not (archive["controllers"] is Array) or archive["controllers"].size() != 2:
        return _failure("invalid_controllers")
    var controllers: Array[String] = []
    for name in archive["controllers"]:
        if not (name is String) or name not in ["bot", "human"]:
            return _failure("invalid_controllers")
        controllers.append(name)
    if not controllers.has("human"):
        return _failure("no_human_slot")
    if not (archive["commands"] is Array) or archive["commands"].size() > MAX_COMMANDS:
        return _failure("invalid_commands")
    if not (archive["final_hash"] is String) or str(archive["final_hash"]).length() != 64:
        return _failure("invalid_final_hash")

    var sim: MirrorMatchState = MATCH.new()
    sim.setup(int(archive["seed"]), controllers)
    if sim.finished:
        return _failure("initialization_failed")
    if sim.map_id != archive["map_id"] or sim.map_hash != archive["map_hash"] or sim.map_source_sha != archive["map_source_sha"]:
        return _failure("map_mismatch")
    if sim.result()["rules"] != archive["rules"]:
        return _failure("rules_mismatch")

    var commands: Array = archive["commands"]
    var last_tick: int = -1
    for i in range(commands.size()):
        var cmd: Variant = commands[i]
        if not (cmd is Dictionary) or cmd.size() != 6:
            return _failure("invalid_command_shape", i)
        for key in ["tick", "slot", "action", "actor_id", "argument", "accepted"]:
            if not cmd.has(key):
                return _failure("missing_command_field", i)
        if not _integer(cmd["tick"], 0, int(archive["final_tick"])):
            return _failure("invalid_command_tick", i)
        if int(cmd["tick"]) < last_tick:
            return _failure("non_monotonic_commands", i)
        last_tick = int(cmd["tick"])
        if not _integer(cmd["slot"], 0, 1) or controllers[int(cmd["slot"])] != "human":
            return _failure("unauthorized_slot", i)
        if not _integer(cmd["actor_id"], -2147483648, 2147483647):
            return _failure("invalid_actor_id", i)
        if not (cmd["action"] is String) or str(cmd["action"]).length() > 64:
            return _failure("invalid_action", i)
        if not (cmd["accepted"] is bool):
            return _failure("invalid_outcome", i)
        if not bool(_argument(cmd["argument"]).get("ok", false)):
            return _failure("unsupported_argument", i)

    return {
        "ok": true, "sim": sim, "commands": commands,
        "final_tick": int(archive["final_tick"]),
        "final_hash": str(archive["final_hash"])
    }

static func playback(archive: Variant) -> Dictionary:
    var prepared: Dictionary = prepare(archive)
    if not bool(prepared.get("ok", false)):
        return prepared
    var sim: MirrorMatchState = prepared["sim"]
    var commands: Array = prepared["commands"]
    var next_command: int = 0
    var terminal_tick: int = int(archive["final_tick"])
    for t in range(terminal_tick + 1):
        while next_command < commands.size() and int(commands[next_command]["tick"]) == sim.tick:
            var order: Dictionary = commands[next_command]
            var arg: Dictionary = _argument(order["argument"])
            var accepted: bool = sim.issue_command(
                int(order["slot"]), str(order["action"]),
                int(order["actor_id"]), arg["value"]
            )
            if accepted != bool(order["accepted"]):
                return _failure("command_outcome_diverged", next_command)
            next_command += 1
        if t == terminal_tick:
            break
        if sim.finished:
            return _failure("finished_before_recorded_tick")
        sim.advance()
    if next_command != commands.size():
        return _failure("unplayed_commands", next_command)
    var final_hash: String = sim.replay_hash()
    if final_hash != str(archive["final_hash"]):
        return {
            "ok": false, "reason": "state_hash_mismatch",
            "expected_hash": str(archive["final_hash"]),
            "actual_hash": final_hash, "command_index": -1
        }
    return {
        "ok": true, "reason": "replay_verified",
        "ticks": sim.tick, "commands": next_command,
        "hash": final_hash, "result": sim.result()
    }

static func _valid_basename(name: String) -> bool:
    if name.is_empty() or name.length() > 64:
        return false
    for i in range(name.length()):
        var c: int = name.unicode_at(i)
        if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95):
            return false
    return true

static func last_basename() -> String:
    # QA can isolate its playback fixture without ever overwriting real user
    # saves. The default game always uses the most recent human replay.
    var requested: String = str(ProjectSettings.get_setting(
        "scalfagus/replay_basename", "last-human-match"
    ))
    return requested if _valid_basename(requested) else "last-human-match"

static func save_user(archive: Dictionary, basename: String) -> String:
    if not _valid_basename(basename):
        return ""
    var root: String = "user://replays"
    if DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(root)) != OK:
        return ""
    var destination: String = root + "/" + basename + ".json"
    var file: FileAccess = FileAccess.open(destination, FileAccess.WRITE)
    if file == null:
        return ""
    file.store_string(JSON.stringify(archive, "  ") + "\n")
    file.flush()
    return destination

static func load_user(basename: String) -> Dictionary:
    if not _valid_basename(basename):
        return {}
    var file: FileAccess = FileAccess.open("user://replays/" + basename + ".json", FileAccess.READ)
    if file == null:
        return {}
    var parsed: Variant = JSON.parse_string(file.get_as_text())
    return parsed if parsed is Dictionary else {}
