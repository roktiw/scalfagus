; Scalfagus native Godot game. No Tauri/WebView runtime.

config_version=5

[application]
config/name="Scalfagus"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=0
window/size/window_height_override=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0

[physics]
3d/default_gravity=15.0

[autoload]
; Explicit runtime autoload avoids requiring an editor session to register Keychain.
; The upstream Keychain editor plugin does nothing except add this autoload.
Keychain="*res://addons/keychain/Keychain.gd"

[editor_plugins]
enabled=PackedStringArray("res://addons/rts_framework/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/gut/plugin.cfg")

[input]
rts_pan_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)]
}

