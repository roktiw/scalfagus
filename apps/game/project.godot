; Scalfagus native Godot game. No Tauri/WebView runtime.

config_version=5

[application]
config/name="Scalfagus"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0

[physics]
3d/default_gravity=15.0

[editor_plugins]
enabled=PackedStringArray("res://addons/rts_framework/plugin.cfg", "res://addons/keychain/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/gut/plugin.cfg")
